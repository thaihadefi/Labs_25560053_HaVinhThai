PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/shop_admin_lab5_db
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Optional: comma-separated UI origins allowed by CORS (default: any origin)
# CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Cron jobs (defaults are the production schedules)
CRON_TIMEZONE=Asia/Ho_Chi_Minh
INVENTORY_REPORT_SCHEDULE=0 0 * * *
ARCHIVE_SCHEDULE=0 * * * *
ARCHIVE_AFTER_MINUTES=1440
# For testing in class: run both jobs every minute and archive after 2 minutes
# INVENTORY_REPORT_SCHEDULE=* * * * *
# ARCHIVE_SCHEDULE=* * * * *
# ARCHIVE_AFTER_MINUTES=2
